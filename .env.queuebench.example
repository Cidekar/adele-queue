# Copy to .env.queuebench and edit before running: make bench:seed
APP_NAME=queuebench
APP_KEY=queuebench-dev-key-not-for-production
APP_URL=http://localhost:4000
APP_DEBUG=true

# CACHE=redis is what tells adele-framework to actually build the redis pool.
# Without it q.Redis.Pool is nil and workers panic on first scan.
CACHE=redis
QUEUE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PREFIX=queuebench
REDIS_MAX_IDEL=50
REDIS_MAX_ACTIVE_CONNECTIONS=10000
REDIS_TIMEOUT=240
REDIS_PASSWORD=

# Optional: uncomment to persist failed_jobs rows.
# DATABASE_TYPE=postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_USER=queuebench
# DATABASE_PASSWORD=
# DATABASE_NAME=queuebench
# DATABASE_SSL_MODE=disable
